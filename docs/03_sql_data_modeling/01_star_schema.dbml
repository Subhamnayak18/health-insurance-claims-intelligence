Table dim.Date {
  DateKey int [pk]
  FullDate date [not null, unique]
  CalendarYear smallint
  CalendarQuarter tinyint
  MonthNumber tinyint
  MonthName varchar(15)
  YearMonth char(7)
  DayOfWeekName varchar(15)
  IsWeekend bit
}

Table dim.Beneficiary {
  BeneficiaryKey bigint [pk, increment]
  BeneID varchar(50) [not null, unique]
}

Table dim.Plan {
  PlanKey int [pk, increment]
  PlanID varchar(20) [not null, unique]
  PlanName varchar(100)
  DeductibleRate decimal(8,4)
  CopayRate decimal(8,4)
  CoverageTier varchar(30)
}

Table dim.Policy {
  PolicyKey bigint [pk, increment]
  PolicyID varchar(50) [not null, unique]
  BeneficiaryKey bigint [not null]
  PlanKey int [not null]
}

Table dim.Provider {
  ProviderKey bigint [pk, increment]
  ProviderID varchar(50) [not null, unique]
}

Table dim.ClaimStatus {
  ClaimStatusKey tinyint [pk, increment]
  ClaimStatus varchar(30) [not null, unique]
  StatusGroup varchar(30)
  StatusSortOrder tinyint
  IsOpen bit
}

Table dim.DenialReason {
  DenialReasonKey smallint [pk, increment]
  DenialReason varchar(50) [not null, unique]
  DenialDescription varchar(250)
  BusinessOwner varchar(100)
}

Table fact.Claim {
  ClaimFactKey bigint [pk, increment]

  ClaimKey varchar(100) [not null, unique]
  ClaimID varchar(100) [not null]
  ClaimType varchar(20) [not null]

  BeneficiaryKey bigint [not null]
  PolicyKey bigint [not null]
  PlanKey int [not null]
  ProviderKey bigint [not null]
  ClaimStatusKey tinyint [not null]
  DenialReasonKey smallint

  ClaimFromDateKey int [not null]
  ClaimThruDateKey int [not null]
  SubmissionDateKey int [not null]
  DecisionDateKey int
  PaymentDateKey int
  AnalysisDateKey int [not null]

  PaymentStatus varchar(30)
  PreauthStatus varchar(30)
  ReviewPriority varchar(20)
  QueueName varchar(50)
  AdjusterID varchar(30)
  DataProvenance varchar(100)

  DocumentsCompleteFlag bit
  PolicyActiveFlag bit
  TreatmentCoveredFlag bit
  WaitingPeriodFlag bit
  PreauthRequiredFlag bit
  SLABreachFlag bit
  ManualReviewFlag bit
  DuplicateIndicator bit
  HighCostFlag bit
  FraudAlertFlag bit

  BilledAmount decimal(18,2)
  EligibleAmount decimal(18,2)
  DeductibleAmount decimal(18,2)
  CopayAmount decimal(18,2)
  NonPayableAmount decimal(18,2)
  AdjustmentAmount decimal(18,2)
  ApprovedAmount decimal(18,2)
  PaidAmount decimal(18,2)
  SourceCMSPaymentAmount decimal(18,2)
  EstimatedLeakageAmount decimal(18,2)

  TurnaroundDays int
  SLATargetDays smallint
  ProviderRiskScore decimal(8,4)
}

Ref: dim.Policy.BeneficiaryKey > dim.Beneficiary.BeneficiaryKey
Ref: dim.Policy.PlanKey > dim.Plan.PlanKey

Ref: fact.Claim.BeneficiaryKey > dim.Beneficiary.BeneficiaryKey
Ref: fact.Claim.PolicyKey > dim.Policy.PolicyKey
Ref: fact.Claim.PlanKey > dim.Plan.PlanKey
Ref: fact.Claim.ProviderKey > dim.Provider.ProviderKey
Ref: fact.Claim.ClaimStatusKey > dim.ClaimStatus.ClaimStatusKey
Ref: fact.Claim.DenialReasonKey > dim.DenialReason.DenialReasonKey

Ref: fact.Claim.ClaimFromDateKey > dim.Date.DateKey
Ref: fact.Claim.ClaimThruDateKey > dim.Date.DateKey
Ref: fact.Claim.SubmissionDateKey > dim.Date.DateKey
Ref: fact.Claim.DecisionDateKey > dim.Date.DateKey
Ref: fact.Claim.PaymentDateKey > dim.Date.DateKey
Ref: fact.Claim.AnalysisDateKey > dim.Date.DateKey
